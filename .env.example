# Copy to `.env` in the repo root. Never commit the real file.

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/projectmgmt

# --- Auth ---
# Random string, 16+ characters:  openssl rand -base64 32
JWT_SECRET=

# First account (Owner). Created or reset on every server start.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=

# --- Credentials vault ---
# Encrypts stored project credentials (AES-256-GCM). Must decode to 32 bytes:
#   openssl rand -base64 32
RESOURCE_VAULT_KEY=

# --- Email (optional: password reset + notifications) ---
# SENDGRID_API_KEY=
# MAIL_FROM=no-reply@example.com
